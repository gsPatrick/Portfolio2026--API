# ------------------------------------------------------------------
# Ambiente
# ------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Prefixo das rotas públicas (a versão v1 é acrescentada pela API)
APP_API_PREFIX=/api

# Origens permitidas no CORS (separadas por vírgula). Use o domínio do front.
# Ex.: https://codebypatrick.dev,http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# ------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# Opção A: uma URL única
# ------------------------------------------------------------------
DATABASE_URL=postgres://usuario:senha@localhost:5432/portfolio_tracking

# Opção B: variáveis separadas (usadas se DATABASE_URL estiver vazia)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_tracking
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
